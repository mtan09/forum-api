# Postgres — local for dev, Neon connection string for production
DATABASE_URL=postgresql://user@localhost:5432/forum

# Auth — HMAC secret for signing JWTs; generate with: openssl rand -hex 32
JWT_SECRET=

# Cloudflare R2 (optional — storage falls back to local ./uploads when unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=forum-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# Separate private bucket. Do not enable public access on this bucket.
R2_FEEDBACK_BUCKET_NAME=forum-feedback-private

# OpenAI — required for /ai/chat (from platform.openai.com)
OPENAI_API_KEY=

# Server
PORT=3000
NODE_ENV=development
WEB_APP_URL=http://localhost:8081

# Email (Resend) — verification + password-reset emails. Unset = emails are
# logged to the server console only in development. Production fails closed.
RESEND_API_KEY=
EMAIL_FROM=forum <onboarding@resend.dev>
SUPPORT_EMAIL=
LEGAL_CONTACT_EMAIL=

# forumAI cost cap — max chats per user per day (default 50)
AI_DAILY_LIMIT=50

# Article analysis. Publisher text is held only in memory while it is scored
# and converted into structured evidence; it is never stored or returned.
ARTICLE_TRANSIENT_ANALYSIS_ENABLED=true
ARTICLE_STRUCTURED_EVIDENCE_ENABLED=true
ARTICLE_ANALYSIS_MODEL=gpt-5.4-nano
ARTICLE_ANALYSIS_DAILY_LIMIT=500

# Managed article images. When enabled and R2 is configured, ingestion stores
# only 640px/1280px WebP variants and retains the publisher URL as provenance.
# Cache failures fall back to loading the remote publisher thumbnail.
ARTICLE_MANAGED_IMAGES_ENABLED=true
ARTICLE_IMAGE_CACHE_DAYS=30

# Crash reporting — required before external beta testing
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
