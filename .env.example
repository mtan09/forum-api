# Postgres — local for dev, Neon connection string for production
DATABASE_URL=postgresql://user@localhost:5432/forum

# Auth — HMAC secret for signing JWTs; generate with: openssl rand -hex 32
JWT_SECRET=

# Cloudflare R2 (optional — storage falls back to local ./uploads when unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=forum-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# OpenAI — required for /ai/chat (from platform.openai.com)
OPENAI_API_KEY=

# News ingestion — fetch/score/publish articles every N minutes while the
# server runs (unset = manual `npm run ingest` only)
INGEST_INTERVAL_MINUTES=60

# Server
PORT=3000
NODE_ENV=development

# Email (Resend) — verification + password-reset emails. Unset = emails are
# logged to the server console instead (dev mode).
RESEND_API_KEY=
EMAIL_FROM=forum <onboarding@resend.dev>
LEGAL_CONTACT_EMAIL=

# forumAI cost cap — max chats per user per day (default 50)
AI_DAILY_LIMIT=50

# Crash reporting (optional) — Sentry DSN for the API project
SENTRY_DSN=
