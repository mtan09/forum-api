# Postgres — local for dev, Neon connection string for production
DATABASE_URL=postgresql://user@localhost:5432/forum

# Auth — HMAC secret for signing JWTs; generate with: openssl rand -hex 32
JWT_SECRET=

# Local fixture utilities only. Supply values in a gitignored local environment;
# never reuse these for an owner, reviewer, or production user account.
FORUM_DEV_SEED_PASSWORD=
# One-off verification input for proving the retired shared fixture credential
# no longer works after demo hardening. Do not configure this on a service.
RELEASE_LEGACY_DEMO_PASSWORD=

# Cloudflare R2 (optional — storage falls back to local ./uploads when unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=forum-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# Separate private bucket. Do not enable public access on this bucket.
R2_FEEDBACK_BUCKET_NAME=forum-feedback-private

# OpenAI — required for /ai/chat (from platform.openai.com)
OPENAI_API_KEY=

# Server
PORT=3000
NODE_ENV=development
WEB_APP_URL=http://localhost:8081
# Production currently uses https://mtan-forum.expo.app
PUBLIC_API_URL=http://localhost:3000
# Production uses https://api.forumeveryside.com

# Email (Resend) — verification + password-reset emails. Unset = emails are
# logged to the server console only in development. Production fails closed.
RESEND_API_KEY=
EMAIL_FROM=forum <accounts@updates.forumeveryside.com>
SUPPORT_EMAIL=support@forumeveryside.com
LEGAL_CONTACT_EMAIL=support@forumeveryside.com

# forumAI cost cap — max chats per user per day (default 50)
AI_DAILY_LIMIT=50

# Timezone-aware in-app/email/push Daily Brief. Set to no for a rollout pause.
DAILY_BRIEF_ENABLED=yes

# Signs the unsubscribe links in Daily Brief email. Falls back to JWT_SECRET
# when unset, which couples the two: rotating session credentials then
# invalidates every unsubscribe link already sitting in a user's inbox, and a
# failing one-click unsubscribe is both a compliance problem and a
# deliverability signal to Gmail and Yahoo. Set this so they rotate
# independently. Must match on forum-api and forum-daily-brief.
BRIEF_UNSUBSCRIBE_SECRET=

# Temporary App Review fixture worker. Keep disabled unless the dedicated
# demo-activity cron is intentionally active; remove/disable after approval.
DEMO_ACTIVITY_ENABLED=no
DEMO_ACTIVITY_MODEL=gpt-5.4-nano
DEMO_ACTIVITY_VOTE_BATCH_SIZE=300
DEMO_ACTIVITY_CONTENT_BATCH_SIZE=8

# Crash reporting — required before App Store release testing
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
