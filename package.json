  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/ingest/run.ts",
    "cluster": "tsx src/ingest/cluster-run.ts",
    "rescore": "tsx src/scoring/rescore.ts",
    "audit:posts": "tsx src/scoring/audit-posts.ts",
