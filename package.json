{
  "name": "forum-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/ingest/run.ts",
    "jobs": "tsx src/jobs/run.ts",
    "cluster": "tsx src/ingest/cluster-run.ts",
    "rescore": "tsx src/scoring/rescore.ts",
    "audit:posts": "tsx src/scoring/audit-posts.ts",
    "audit:moderation": "tsx src/moderation/audit-corpus.ts",
    "seed:dev": "node scripts/seed-dev.mjs",
    "seed:community": "node scripts/seed-community.mjs",
    "seed:expand": "node scripts/seed-expand.mjs",
    "seed:stances": "tsx src/scoring/seed-stance-posts.ts",
    "setup:install": "bash scripts/install-clis.sh",
    "setup": "node scripts/setup.mjs",
    "account:release": "tsx scripts/create-release-account.ts",
    "migrate:release": "tsx scripts/apply-release-migration.ts",
    "verify:release": "tsx scripts/verify-release-migration.ts",
    "storage:feedback": "tsx scripts/ensure-feedback-bucket.ts",
    "verify:feedback-storage": "tsx scripts/verify-feedback-storage.ts",
    "migrate:rights": "tsx scripts/apply-rights-migration.ts",
    "backfill:article-metadata": "tsx scripts/backfill-article-metadata.ts",
    "verify:rights": "tsx scripts/verify-rights-migration.ts",
    "audit:article-cleanup": "tsx scripts/cleanup-article-content.ts",
    "cleanup:articles": "APPLY_ARTICLE_RIGHTS_CLEANUP=true tsx scripts/cleanup-article-content.ts",
    "migrate:article-analysis": "tsx scripts/apply-article-analysis-migration.ts",
    "backfill:article-evidence": "tsx scripts/backfill-article-evidence.ts",
    "verify:article-analysis": "tsx scripts/verify-article-analysis.ts",
    "expire:article-images": "tsx scripts/expire-article-images.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@extractus/article-extractor": "^8.1.0",
    "@hono/node-server": "^2.0.12",
    "@sentry/node": "^10.67.0",
    "dotenv": "^16.4.0",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.12.32",
    "openai": "^6.48.0",
    "pg": "^8.13.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
